// ============================================================
// Proyecto Semana 05: ConnectPro — Red Social Profesional
// Archivo: connectpro.dbml
//
// Instrucciones:
//   1. Lee el README.md del proyecto para entender el dominio
//   2. Completa cada sección marcada con TODO
//   3. Pega el contenido en https://dbdiagram.io para visualizar
//   4. Verifica que no haya errores de sintaxis antes de entregar
//
// Convenciones:
//   - PK: uuid [pk, default: `gen_random_uuid()`]
//   - Columnas: auto-documentadas con prefijo de entidad
//   - Metadatos de auditoría: created_at, updated_at (sin prefijo)
//   - ref: -  para relaciones 1-1 (herencia CTI)
//   - ref: >  para relaciones N-1
//   - ref: <> para relaciones N-N
// ============================================================


// ─────────────────────────────────────────────────────────────
// 1. USUARIOS — supertipo base de todos los usuarios
// ─────────────────────────────────────────────────────────────

Table users {
  user_id        uuid         [pk, default: `gen_random_uuid()`]
  user_name      varchar(100) [not null]
  user_email     varchar(150) [not null, unique]
  user_password  varchar(255) [not null, note: "Almacenar solo el hash, nunca texto plano"]
  user_photo_url text

  // TODO: Agrega la columna discriminadora para el tipo de cuenta (básica o premium)
  // Pista: debe ser NOT NULL porque la cobertura es TOTAL

  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_email [unique, name: 'uq_users_email']
  }
}


